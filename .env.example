# Copy to .env for local runs. Never commit real values.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
GEMINI_API_KEY=
# gemini-2.5-flash is no longer available to new API keys (Oct 2026); see docs/DECISIONS.md
GEMINI_MODEL=gemini-3.8-flash
GNEWS_API_KEY=
RESEND_API_KEY=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=Mausam <onboarding@resend.dev>
# Long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
APP_BASE_URL=https://<project>.vercel.app
INVESTING_PLATFORM_URL=https://www.mfcentral.com
TZ_DISPLAY=Asia/Kolkata
# Optional: put all tables in their own Postgres schema (useful when sharing one database)
DB_SCHEMA=
