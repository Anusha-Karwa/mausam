{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "functions": {
    "index.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 2 * * 6"
    }
  ]
}
