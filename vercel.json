{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{app,db}/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 18 * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 2 * * 6" }
  ]
}
